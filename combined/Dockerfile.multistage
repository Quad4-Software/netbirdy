# Multistage combined server image that builds netbirdy-server from source.
#
# Builder is Chainguard's Go image: go1.27.x with gcc and git included, pinned
# by digest. Its CGO build links musl, so the runtime is Chainguard wolfi-base,
# which carries the same libc plus the CA certificate bundle and a shell.
FROM cgr.dev/chainguard/go@sha256:78352255a8760797dac56865a5b9af2881f245ef74c90199e4e15f52251c5357 AS builder
WORKDIR /app

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .

# Build with version info from git (matching goreleaser ldflags).
# BuildKit cache mounts persist the module + build caches across image builds,
# so a source change recompiles incrementally instead of from scratch.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=1 GOOS=linux go build \
    -ldflags="-s -w \
    -X github.com/netbirdio/netbird/version.version=$(git describe --tags --always --dirty 2>/dev/null || echo 'dev') \
    -X main.commit=$(git rev-parse --short HEAD 2>/dev/null || echo 'unknown') \
    -X main.date=$(date -u +%Y-%m-%dT%H:%M:%SZ) \
    -X main.builtBy=docker" \
    -o netbirdy-server ./combined

FROM cgr.dev/chainguard/wolfi-base@sha256:e9b8c3739e5fb5fc778843a2ce74f8620588c9ddc9c44918cead527abcb0b628
ENTRYPOINT [ "/go/bin/netbirdy-server" ]
CMD ["--config", "/etc/netbird/config.yaml"]
COPY --from=builder /app/netbirdy-server /go/bin/netbirdy-server
