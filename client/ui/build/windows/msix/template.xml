<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="netbirdy-ui"
        Arguments=""
        InstallLocation="C:\Program Files\NetBirdy\NetBirdy">
    </Installer>
    <PackageInformation
        PackageName="NetBirdy"
        PackageDisplayName="NetBirdy"
        PublisherName="CN=NetBirdy"
        PublisherDisplayName="NetBirdy"
        Version="0.0.1.0"
        PackageDescription="NetBirdy desktop client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.netbirdy.client"
                Description="NetBirdy desktop client"
                DisplayName="NetBirdy"
                ExecutableName="netbirdy-ui"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>NetBirdy</DisplayName>
            <PublisherDisplayName>NetBirdy</PublisherDisplayName>
            <Description>NetBirdy desktop client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="netbirdy-ui.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
