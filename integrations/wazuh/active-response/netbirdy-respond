#!/usr/bin/env python3
"""Wazuh active response: act on a NetBirdy peer flagged by a rule.

Reads the AR JSON message on stdin ({command, parameters.alert}),
extracts alert.data.peer_id / account_id, and calls the NetBirdy REST
API with a PAT to set peer state. Default mode is dry-run (logs what it
would do). Env file /var/ossec/etc/netbirdy-ar.env provides:
  NETBIRDY_URL      base URL of the management API
  NETBIRDY_TOKEN    PAT for API calls
  NETBIRDY_AR_MODE  dry-run|enforce (default dry-run)
  NETBIRDY_CA       optional CA bundle path for TLS verify
  NETBIRDY_ALLOWLIST  comma-separated peer ids or names never acted on
"""
import json, os, ssl, sys, time, urllib.request

LOG = "/var/ossec/logs/active-responses.log"
ENV_FILE = "/var/ossec/etc/netbirdy-ar.env"
TIMEOUT = 10

def load_env(path=ENV_FILE):
    env = {}
    try:
        for line in open(path):
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                env[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return env

def log(msg):
    try:
        with open(LOG, "a") as f:
            f.write(f"{time.strftime('%Y-%m-%dT%H:%M:%S')} netbirdy-respond: {msg}\n")
    except OSError:
        pass

def read_ar_message():
    line = sys.stdin.read().strip()
    if not line:
        return None
    return json.loads(line)

def api_req(url, token, method, path, payload, ca):
    req = urllib.request.Request(
        f"{url.rstrip('/')}{path}",
        data=json.dumps(payload).encode() if payload is not None else None,
        method=method,
        headers={"Authorization": f"Token {token}", "Content-Type": "application/json"},
    )
    ctx = ssl.create_default_context(cafile=ca) if ca else ssl.create_default_context()
    with urllib.request.urlopen(req, timeout=TIMEOUT, context=ctx) as resp:
        return resp.status, json.loads(resp.read() or b"{}")

def call_api(url, token, peer_id, ca):
    # PeerRequest requires name/ssh_enabled/login_expiration_enabled/
    # inactivity_expiration_enabled; fetch the peer first and merge.
    _, peer = api_req(url, token, "GET", f"/api/peers/{peer_id}", None, ca)
    payload = {
        "name": peer.get("name", ""),
        "ssh_enabled": peer.get("ssh_enabled", False),
        "login_expiration_enabled": peer.get("login_expiration_enabled", False),
        "inactivity_expiration_enabled": peer.get("inactivity_expiration_enabled", False),
        "approval_required": True,
    }
    status, _ = api_req(url, token, "PUT", f"/api/peers/{peer_id}", payload, ca)
    return status

def allowed(peer_id, peer_name, allowlist):
    return peer_id in allowlist or (peer_name and peer_name in allowlist)

def action_for(alert):
    """Map the fired rule to an action. Rules in group netbirdy carry a
    `rule` field naming the detection; prevention mapping is static."""
    rule = alert.get("data", {}).get("rule", "")
    if rule == "concurrent_connections":
        return "approve-required"
    if rule in ("peer_new_ip", "peer_meta_mismatch", "peer_ip_flap"):
        return "approve-required"
    return None

def main():
    msg = read_ar_message()
    if not msg:
        return 0
    cmd = msg.get("command", "")
    alert = msg.get("parameters", {}).get("alert", {})
    data = alert.get("data", {})
    peer_id = data.get("peer_id") or data.get("peer")
    peer_name = data.get("peer_name", "")
    env = load_env()
    mode = env.get("NETBIRDY_AR_MODE", "dry-run")
    allowlist = set(filter(None, env.get("NETBIRDY_ALLOWLIST", "").split(",")))

    action = action_for(alert)
    if not peer_id or not action:
        log(f"no action for rule={data.get('rule')} peer={peer_id}")
        return 0
    if allowed(peer_id, peer_name, allowlist):
        log(f"skip allowlisted peer {peer_id}")
        return 0
    if cmd == "delete":
        log(f"delete/undo noop for peer {peer_id}")
        return 0

    url = env.get("NETBIRDY_URL", "")
    token = env.get("NETBIRDY_TOKEN", "")
    if not url or not token:
        log("missing NETBIRDY_URL or NETBIRDY_TOKEN")
        return 1
    if mode != "enforce":
        log(f"DRY-RUN would {action} peer={peer_id} account={data.get('account_id')}")
        return 0
    try:
        status = call_api(url, token, peer_id, env.get("NETBIRDY_CA"))
        log(f"{action} peer={peer_id} status={status}")
    except Exception as e:  # noqa: BLE001 - AR must not crash
        log(f"{action} peer={peer_id} failed: {e}")
        return 1
    return 0

if __name__ == "__main__":
    sys.exit(main())
