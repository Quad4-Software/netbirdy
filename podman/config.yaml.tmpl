# NetBirdy combined server configuration for the local podman preview.
# Generated from this template by podman/setup.sh. HTTP only, localhost only.
server:
  listenAddress: ":8081"
  exposedAddress: "http://localhost:8081"
  stunPorts:
    - 3478
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"

  authSecret: "@AUTH_SECRET@"
  dataDir: "/var/lib/netbird"

  disableAnonymousMetrics: true
  disableGeoliteUpdate: true

  security:
    mode: "observe"
    learning_period: "168h"
    audit_log_file: "audit-events.jsonl"

  auth:
    issuer: "http://localhost:8081/oauth2"
    signKeyRefreshEnabled: true
    sessionCookieEncryptionKey: "@SESSION_COOKIE_ENCRYPTION_KEY@"
    dashboardRedirectURIs:
      - "http://localhost:8080/nb-auth"
      - "http://localhost:8080/nb-silent-auth"
    dashboardPostLogoutRedirectURIs:
      - "http://localhost:8080/"
    cliRedirectURIs:
      - "http://localhost:53000/"
    owner:
      email: "@OWNER_EMAIL@"
      password: "@OWNER_PASSWORD_HASH@"

  store:
    engine: "sqlite"
    encryptionKey: "@STORE_ENCRYPTION_KEY@"
