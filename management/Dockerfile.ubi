# Management image for arbitrary non-root UIDs (OpenShift, Podman). The binary
# is built by goreleaser (CGO_ENABLED=1) and injected into the build context;
# see .goreleaser.yaml dockers_v2.
#
# The cgo binary links glibc, so the runtime is Chainguard glibc-dynamic,
# pinned by digest. It has no shell, so the data directories and licenses are
# prepared in a wolfi-base stage and copied across with their ownership and
# modes intact.
FROM cgr.dev/chainguard/wolfi-base@sha256:e9b8c3739e5fb5fc778843a2ce74f8620588c9ddc9c44918cead527abcb0b628 AS fs
COPY licenses/ /image/licenses/
# Only the data directory shares the root group for arbitrary non-root UIDs.
# Runtime-created keys and databases retain the application's restrictive modes.
RUN mkdir -p /image/var/lib/netbird /image/etc/netbird && \
    chown 1000:0 /image/var/lib/netbird && \
    chmod 0770 /image/var/lib/netbird && \
    chmod -R a+rX /image/licenses

FROM cgr.dev/chainguard/glibc-dynamic@sha256:2c362104c7f7adc37e6bdc87451450ff3834871a6268d930815cbe561493f947
ARG TARGETPLATFORM
ARG VERSION=dev
ARG RELEASE=1

LABEL name="netbirdy-management" \
      maintainer="NetBirdy <dev@netbird.io>" \
      vendor="NetBirdy GmbH" \
      version="${VERSION}" \
      release="${RELEASE}" \
      summary="NetBirdy Management" \
      description="NetBirdy Management is the control plane of a NetBirdy network and serves its REST and gRPC APIs."

COPY --chmod=0555 ${TARGETPLATFORM}/netbirdy-mgmt /go/bin/netbirdy-mgmt
COPY --from=fs /image/licenses /licenses
COPY --from=fs --chown=1000:0 /image/var/lib /var/lib
COPY --from=fs /image/etc/netbird /etc/netbird

USER 1000:0
ENV HOME=/var/lib/netbird
# Runtimes such as OpenShift and Podman reserve ports below 1024 for root, so
# --port defaults to 8080 here. With --letsencrypt-domain, forward public 443
# to --port and set --letsencrypt-listen-address to empty, so the main listener
# answers the TLS-ALPN challenges. 33073 is the legacy gRPC port.
EXPOSE 8080 33073
STOPSIGNAL SIGTERM
ENTRYPOINT ["/go/bin/netbirdy-mgmt", "management"]
CMD ["--port", "8080", "--log-file", "console"]
