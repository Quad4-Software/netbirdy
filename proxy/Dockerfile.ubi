# Reverse proxy image for arbitrary non-root UIDs (OpenShift, Podman). The
# binary is built by goreleaser and injected into the build context; see
# .goreleaser.yaml dockers_v2.
#
# Base is Chainguard wolfi-base, pinned by digest. It ships a shell, apk and
# the CA certificate bundle, and runs the CGO-free binary unchanged.
FROM cgr.dev/chainguard/wolfi-base@sha256:e9b8c3739e5fb5fc778843a2ce74f8620588c9ddc9c44918cead527abcb0b628

ARG TARGETPLATFORM
ARG VERSION=dev
ARG RELEASE=1

LABEL name="netbirdy-reverse-proxy" \
      maintainer="NetBirdy <dev@netbird.io>" \
      vendor="NetBirdy GmbH" \
      version="${VERSION}" \
      release="${RELEASE}" \
      summary="NetBirdy Reverse Proxy" \
      description="NetBirdy Reverse Proxy provides an identity-aware entrypoint to services in NetBirdy networks."

COPY --chmod=0555 ${TARGETPLATFORM}/netbirdy-proxy /go/bin/netbirdy-proxy
COPY licenses/ /licenses/
# Only the data directories share the root group for arbitrary non-root UIDs.
# Runtime-created keys retain the application's restrictive modes.
RUN mkdir -p /var/lib/netbird /certs && \
    chown 1000:0 /var/lib/netbird /certs && \
    chmod 0770 /var/lib/netbird /certs && \
    chmod -R a+rX /licenses

USER 1000:0
ENV HOME=/var/lib/netbird
ENV NB_PROXY_ADDRESS=":8443"
ENV NB_PROXY_ACME_ADDRESS=":8081"
EXPOSE 8443
STOPSIGNAL SIGTERM
ENTRYPOINT ["/go/bin/netbirdy-proxy"]
