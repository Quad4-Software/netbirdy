# Multistage proxy image that builds netbirdy-proxy from source. Used for local
# builds and tests; releases use proxy/Dockerfile with a goreleaser binary.
#
# Builder is Chainguard's Go image (go1.27.x, gcc and git included). Runtime is
# Chainguard busybox, the equivalent of the old distroless base:debug.
FROM cgr.dev/chainguard/go@sha256:78352255a8760797dac56865a5b9af2881f245ef74c90199e4e15f52251c5357 AS builder
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY client ./client
COPY dns ./dns
COPY encryption ./encryption
COPY flow ./flow
COPY formatter ./formatter
COPY monotime ./monotime
COPY management ./management
COPY proxy ./proxy
COPY route ./route
COPY shared ./shared
COPY sharedsock ./sharedsock
COPY trustedproxy ./trustedproxy
COPY upload-server ./upload-server
COPY util ./util
COPY version ./version
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o netbirdy-proxy ./proxy/cmd/proxy

FROM cgr.dev/chainguard/busybox@sha256:63f6bae487adff606359bd82418ffe0564564a6b272cf52107306749a714afb2
# Chainguard busybox defaults to uid 65532; the chown below needs root.
USER 0:0

RUN echo "netbirdy:x:1000:1000:netbirdy:/var/lib/netbird:/sbin/nologin" >> /etc/passwd && \
    echo "netbirdy:x:1000:" >> /etc/group && \
    mkdir -p /var/lib/netbird /certs && \
    chown -R 1000:1000 /var/lib/netbird /certs && \
    chmod 755 /certs

COPY --from=builder /app/netbirdy-proxy /usr/bin/netbirdy-proxy
USER netbirdy:netbirdy
ENV HOME=/var/lib/netbird
ENV NB_PROXY_ADDRESS=":8443"
EXPOSE 8443
ENTRYPOINT ["/usr/bin/netbirdy-proxy"]
