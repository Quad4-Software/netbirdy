{
  "name": "netbirdy-dashboard",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "copy": "copyfiles -f ./node_modules/@axa-fr/react-oidc/dist/OidcServiceWorker.js ./public",
    "copytrusted": "copyfiles -f ./public/local/OidcTrustedDomains.js ./public",
    "dev": "next dev -p 3000",
    "build": "next build",
    "postbuild": "node postbuild.js",
    "start": "next start",
    "lint": "eslint .",
    "test:setup": "cd ./e2e/environment && sh create-test-env.sh",
    "test:clean": "cd ./e2e/environment && sh clean-test-env.sh",
    "test:dev": "cross-env APP_ENV=test next dev -p 1337",
    "test": "pnpm exec playwright test --config=e2e/playwright.config.ts",
    "test:unit": "cross-env NODE_OPTIONS=--localstorage-file=.vitest-localstorage vitest run",
    "test:unit:watch": "vitest",
    "test:ui": "pnpm exec playwright test --config=e2e/playwright.config.ts --ui",
    "test:ci": "cross-env APP_ENV=test next build && pnpm exec playwright test --config=e2e/playwright.config.ts",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:visual": ".storybook/visual-regression/run.sh",
    "docs:build": "node scripts/build-docs.mjs",
    "prebuild": "pnpm run docs:build",
    "predev": "pnpm run docs:build"
  },
  "dependencies": {
    "@axa-fr/react-oidc": "^7.29.8",
    "@dagrejs/dagre": "^1.1.8",
    "@radix-ui/react-accordion": "^1.2.12",
