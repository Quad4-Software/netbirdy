# Wolfi base, pinned by digest, replaces alpine. apk provides nginx-stable
# (the stable branch), bash, gettext and tzdata. The image runs nginx as the
# arbitrary UID it is started with, so all runtime state stays under
# /tmp/nginx, group-writable by the root group.
FROM cgr.dev/chainguard/wolfi-base@sha256:e9b8c3739e5fb5fc778843a2ce74f8620588c9ddc9c44918cead527abcb0b628

RUN apk add --no-cache bash ca-certificates-bundle gettext nginx-stable tzdata && \
    mkdir -p /etc/nginx/http.d /tmp/nginx

STOPSIGNAL SIGINT
EXPOSE 8080

WORKDIR /usr/share/nginx/html

COPY docker/default.conf /etc/nginx/http.d/default.conf
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/rootless.conf /etc/nginx/http.d/rootless.conf
COPY docker/init_react_envs.sh /usr/local/init_react_envs.sh
COPY out/ /usr/share/nginx/html/

RUN sed -i \
      -e 's/listen 80 default_server;/listen 8080 default_server;/' \
      -e 's/listen \[::\]:80 default_server;/listen [::]:8080 default_server;/' \
      /etc/nginx/http.d/default.conf && \
    sed -i '/^user nginx;$/d' /etc/nginx/nginx.conf && \
    chmod +x /usr/local/init_react_envs.sh && \
    chgrp -R 0 /etc/nginx/http.d /usr/share/nginx/html /tmp/nginx && \
    chmod -R g=u /etc/nginx/http.d /usr/share/nginx/html /tmp/nginx

USER 10001:0
ENTRYPOINT ["/usr/local/init_react_envs.sh"]
CMD ["/usr/bin/nginx", "-e", "/dev/stderr", "-g", "pid /tmp/nginx.pid;"]
